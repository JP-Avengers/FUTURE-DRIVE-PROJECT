            color3f[] primvars:displayColor = [(0.94, 0.4, 0.03)]
            double radius = 0.22
            double3 xformOp:translate = (-2.9035242376287407, -13.121803762610142, 0.3485257190916631)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

