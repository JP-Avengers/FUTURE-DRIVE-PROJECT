def "World"
{
    def Xform "Obstacles"
    {
        def Cone "cone_0" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.7
            rel material:binding = </World/Obstacles/cone_0_mat>
            color3f[] primvars:displayColor = [(0.96, 0.41, 0.02)]
            double radius = 0.2
            double3 xformOp:translate = (-2.737577163640265, -12.304813039295778, 0.3354868612830665)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Material "cone_0_mat"
        {
            token outputs:surface.connect = </World/Obstacles/cone_0_mat/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.96, 0.41, 0.02)
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

