#usda 1.0
(
    customLayerData = {
        string generated_by = "sim/make_obstacles.py"
        string obstacles_json = '[{"name": "box_slalom_1", "type": "box", "x": -12.819, "y": -18.517, "z_floor": 0.098, "yaw_deg": 167.07, "size": [0.6, 0.6, 0.8], "s": 22.0, "lateral": -0.5}, {"name": "box_slalom_2", "type": "box", "x": -22.79, "y": -17.257, "z_floor": 0.131, "yaw_deg": 167.07, "size": [0.6, 0.6, 0.8], "s": 32.0, "lateral": 0.5}]'
        string scenario = "eval/scenarios/parking_r3_obs_slalom.yaml"
    }
    doc = "시나리오 장애물 — parking_r3_obs_slalom (eval/scenarios/parking_r3_obs_slalom.yaml). FD_LAYERS 로 씬 위에 얹음"
    metersPerUnit = 1
    upAxis = "Z"
)

def "World"
{
    def Xform "Obstacles"
    {
        def Cube "box_slalom_1" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        )
        {
            rel material:binding = </World/Obstacles/box_slalom_1_mat>
            color3f[] primvars:displayColor = [(0.55, 0.38, 0.22)]
            double size = 1
            float3 xformOp:rotateXYZ = (0, 0, 167.074)
            float3 xformOp:scale = (0.6, 0.6, 0.8)
            double3 xformOp:translate = (-12.81891379464056, -18.51743010521958, 0.49803081080192135)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        }

        def Material "box_slalom_1_mat"
        {
            token outputs:surface.connect = </World/Obstacles/box_slalom_1_mat/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.38, 0.22)
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

        def Cube "box_slalom_2" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        )
        {
            rel material:binding = </World/Obstacles/box_slalom_2_mat>
            color3f[] primvars:displayColor = [(0.55, 0.38, 0.22)]
            double size = 1
            float3 xformOp:rotateXYZ = (0, 0, 167.074)
            float3 xformOp:scale = (0.6, 0.6, 0.8)
            double3 xformOp:translate = (-22.78951020535944, -17.257193894780418, 0.5313150782875224)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        }

        def Material "box_slalom_2_mat"
        {
            token outputs:surface.connect = </World/Obstacles/box_slalom_2_mat/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.38, 0.22)
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }
    }
}

