#usda 1.0
(
    customLayerData = {
        string generated_by = "sim/make_obstacles.py"
        string obstacles_json = '[{"name": "ped_north", "type": "cylinder", "x": -15.195, "y": -1.842, "z_floor": -0.052, "yaw_deg": -12.98, "size": [0.5, 1.7], "s": 74.2, "lateral": 0.0}]'
        string scenario = "eval/scenarios/parking_r3_obs_north_ped.yaml"
        string start_json = "null"
    }
    doc = "시나리오 장애물 — parking_r3_obs_north_ped (eval/scenarios/parking_r3_obs_north_ped.yaml). FD_LAYERS 로 씬 위에 얹음"
    metersPerUnit = 1
    upAxis = "Z"
)

def "World"
{
    def Xform "Obstacles"
    {
        def Cylinder "ped_north" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 1.7
            rel material:binding = </World/Obstacles/ped_north_mat>
            color3f[] primvars:displayColor = [(0.2, 0.3, 0.55)]
            double radius = 0.25
            double3 xformOp:translate = (-15.194523999999996, -1.842192000000001, 0.7982994406332503)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Material "ped_north_mat"
        {
            token outputs:surface.connect = </World/Obstacles/ped_north_mat/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.3, 0.55)
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }
    }
}

