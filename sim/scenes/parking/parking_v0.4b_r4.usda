#usda 1.0
(
    customLayerData = {
        string lights = "돔 880 (하늘 텍스처 위 반구 평균 밝기로 나눠 텍스처 없는 돔 600 과 같은 밝기) · 해 0. 하늘을 끄려면 sky.usda 줄을 빼고 600"
        string map = "data/usd/parking_v0.4b_r4/ — C 이진우 10.13 r4: r3 + 납작한 조각·잡음 덩어리 원본에서 지움 + 북쪽 차로 바닥 + 먼 구역 3D(VisualFar, 키프레임 RGB-D TSDF, 충돌 없음) + 하늘 돔 텍스처. D 보정 레이어(parking_v0.4b_r3_dfix) 불필요"
        string start_pose = "기준선 eval/routes/parking_r3_cw.yaml 출발점 (D 10.13 그대로) — r4 는 r3 와 좌표·바닥 높이가 같음"
    }
    defaultPrim = "World"
    doc = "실제 주차장 씬(맵 v0.4b r4) 루트 제안 — D 의 parking_v0.4b_r3.usda 에서 dfix 레이어를 빼고 r4 · 하늘 레이어를 넣음. 좌표는 B 맵 좌표(ENU 아님)"
    metersPerUnit = 1
    subLayers = [
        @../proxy/sensors.usda@,
        @../proxy/ros.usda@,
        @../proxy/robot.usda@,
        @../../../data/usd/parking_v0.4b_r4/usd/sky.usda@,
        @../../../data/usd/parking_v0.4b_r4/usd/parking_scene.usda@,
        @../proxy/world.usda@
    ]
    timeCodesPerSecond = 60
    upAxis = "Z"
)

over "World"
{
    over "Nova_Carter_ROS"
    {
        float xformOp:rotateZ = -96.0
        double3 xformOp:translate = (-1.756, -7.621, -0.035)
    }

    over "Lights"
    {
        over "Dome"
        {
            float inputs:intensity = 880
        }

        over "Sun"
        {
            float inputs:intensity = 0
        }
    }
}
