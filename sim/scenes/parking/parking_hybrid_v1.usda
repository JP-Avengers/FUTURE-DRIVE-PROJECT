#usda 1.0
(
    customLayerData = {
        string lights = "돔 880 (하늘 텍스처 위 반구 평균 밝기로 나눠 텍스처 없는 돔 600 과 같은 밝기) · 해 0. 하늘을 끄려면 sky.usda 줄을 빼고 600"
        string map = "data/usd/parking_hybrid_v1/ — C 이진우 11.15: 혼합 맵 (11.13 미팅의 세 맵 중 혼합). v0.9 뼈대(좌표 · 바닥 높이 · 충돌 바닥) + 휘어 맞춘 폴리캠 겉모습 · 물체. 경로 위 바닥 높이는 v0.9 와 같음"
        string start_pose = "기준선 eval/routes/parking_r3_cw.yaml 출발점 (D 10.13 그대로). v0.5 바닥 −0.061 + 0.022 = −0.039 (r4 는 −0.035)"
    }
    defaultPrim = "World"
    doc = "주차장 혼합 맵 v1 루트 제안 — v0.9 루트에서 맵 경로만 바꿈 (로봇 시작 · 조명 · 하늘은 v0.9 그대로, 하늘은 v0.9 폴더의 sky.usda 를 씀). Isaac Sim 에서 열어 보지 못함"
    metersPerUnit = 1
    subLayers = [
        @../proxy/sensors.usda@,
        @../proxy/ros.usda@,
        @../proxy/robot.usda@,
        @../../../data/usd/parking_v0.9/usd/sky.usda@,
        @../../../data/usd/parking_hybrid_v1/usd/parking_scene.usda@,
        @../proxy/world.usda@
    ]
    timeCodesPerSecond = 60
    upAxis = "Z"
)

over "World"
{
    over "Nova_Carter_ROS"
    {
        float xformOp:rotateZ = -96.0
        double3 xformOp:translate = (-1.756, -7.621, -0.039)
    }

    over "Lights"
    {
        over "Dome"
        {
            float inputs:intensity = 880
        }

        over "Sun"
        {
            float inputs:intensity = 0
        }
    }
}
