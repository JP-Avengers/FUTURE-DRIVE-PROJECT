#usda 1.0
(
    customLayerData = {
        string lights = "돔 880 (하늘 텍스처 위 반구 평균 밝기로 나눠 텍스처 없는 돔 600 과 같은 밝기) · 해 0. 하늘을 끄려면 sky.usda 줄을 빼고 600"
        string map = "data/usd/parking_v0.9/ — C 이진우 11.12: 화면 개선판 (평가판은 v0.8 r3 그대로). B 맵 v0.5g 섬 바닥 · 주차선 다시 그림 · 손으로 놓은 차 23대(CC0 차 모양) · 만든 연석 · 인도 숨김 · 둘레 스캔 바닥(Perimeter, 보이기만). 경로 위 바닥 높이 · 좌표는 v0.8 r3 와 같음"
        string start_pose = "기준선 eval/routes/parking_r3_cw.yaml 출발점 (D 10.13 그대로). v0.5 바닥 −0.061 + 0.022 = −0.039 (r4 는 −0.035)"
    }
    defaultPrim = "World"
    doc = "실제 주차장 씬(맵 v0.9) 루트 제안 — v0.8 r3 에서 경로만 v0.9 로 (경로 위 바닥 높이 같음 → 로봇 시작 그대로). 좌표는 B 맵 좌표(ENU 아님)"
    metersPerUnit = 1
    subLayers = [
        @../proxy/sensors.usda@,
        @../proxy/ros.usda@,
        @../proxy/robot.usda@,
        @../../../data/usd/parking_v0.9/usd/sky.usda@,
        @../../../data/usd/parking_v0.9/usd/parking_scene.usda@,
        @../proxy/world.usda@
    ]
    timeCodesPerSecond = 60
    upAxis = "Z"
)

over "World"
{
    over "Nova_Carter_ROS"
    {
        float xformOp:rotateZ = -96.0
        double3 xformOp:translate = (-1.756, -7.621, -0.039)
    }

    over "Lights"
    {
        over "Dome"
        {
            float inputs:intensity = 880
        }

        over "Sun"
        {
            float inputs:intensity = 0
        }
    }
}
