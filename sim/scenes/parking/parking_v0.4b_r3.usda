#usda 1.0
(
    customLayerData = {
        string lights = "돔 600 · 해 0 — 사진 색에 그림자가 이미 들어 있음, 10.12 비교 렌더로 정함"
        string map = "data/usd/parking_v0.4b_r3/ — C 이진우 10.12 r3 (바닥 한 겹·색 선형·잔상 지움), B 맵 v0.4b(본네트 카메라). D 보정 1개(10.13): parking_v0.4b_r3_dfix/collision_fix_w.usdc — 서쪽 끝 (−36.8, −7.35) 바닥 위 납작한 조각 6삼각형 지움(PhysX 멈춤), C 가 고치면 뺌"
        string start_pose = "기준선 eval/routes/parking_r3_cw.yaml 출발점 — 화단 3 m 선 NE 모서리 원호 끝, 시계 방향(10.13 임시). 바닥 −0.057 + 0.022. 이전: route_bonnet_cw.csv 회차 0 첫 점 (−1.6, −4.893, −97.4°)"
    }
    defaultPrim = "World"
    doc = "실제 주차장 씬(맵 v0.4b) 루트 — 이 파일을 연다. Proxy 씬의 env_proxy · background 자리에 C 의 USD 를 넣고 로봇 · 센서 · ROS · 물리 · 조명은 Proxy 레이어를 그대로 쓴다(조명 세기만 여기서 바꿈). 좌표는 B 맵 좌표(원점 = 10.5 촬영 첫 키프레임, 방위 임의, 주 바닥 z 0) — Proxy 의 ENU 와 다르다"
    metersPerUnit = 1
    subLayers = [
        @../proxy/sensors.usda@,
        @../proxy/ros.usda@,
        @../proxy/robot.usda@,
        @../../../data/usd/parking_v0.4b_r3_dfix/collision_fix_w.usdc@,
        @../../../data/usd/parking_v0.4b_r3/usd/parking_scene.usda@,
        @../proxy/world.usda@
    ]
    timeCodesPerSecond = 60
    upAxis = "Z"
)

over "World"
{
    over "Nova_Carter_ROS"
    {
        float xformOp:rotateZ = -96.0
        double3 xformOp:translate = (-1.756, -7.621, -0.035)
    }

    over "Lights"
    {
        over "Dome"
        {
            float inputs:intensity = 600
        }

        over "Sun"
        {
            float inputs:intensity = 0
        }
    }
}

