                token outputs:surface
            }
        }

        def Material "car_0"
        {
            token outputs:surface.connect = </World/Looks/car_0/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.78, 0.8)
                float inputs:metallic = 0.3
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "car_1"
        {
            token outputs:surface.connect = </World/Looks/car_1/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12, 0.12, 0.13)
                float inputs:metallic = 0.3
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "car_2"
        {
            token outputs:surface.connect = </World/Looks/car_2/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.07, 0.07)
                float inputs:metallic = 0.3
