            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.32, 0.46, 0.56)
                float inputs:metallic = 0.4
                float inputs:roughness = 0.15
                token outputs:surface
            }
        }

        def Material "brick"
        {
            token outputs:surface.connect = </World/Looks/brick/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.27, 0.2)
                float inputs:metallic = 0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "grass"
        {
            token outputs:surface.connect = </World/Looks/grass/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.24, 0.38, 0.17)
