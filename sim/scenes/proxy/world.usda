#usda 1.0
(
    customLayerData = {
        string generated_by = "sim/build_proxy_scene.py"
        string params = "sim/scenes/proxy/params.yaml"
        string proxy_version = "v0"
    }
    doc = "sim/build_proxy_scene.py 가 만든 레이어 — 손으로 고치지 말고 params.yaml 을 고쳐 다시 만들 것"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def PhysicsScene "PhysicsScene" (
        prepend apiSchemas = ["PhysxSceneAPI"]
    )
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
        uniform token physxScene:broadphaseType = "MBP"
        bool physxScene:enableCCD = 1
        bool physxScene:enableGPUDynamics = 0
        bool physxScene:enableStabilization = 1
        uniform token physxScene:solverType = "TGS"
    }

    def Xform "Lights"
    {
        def DomeLight "Dome"
        {
            float inputs:intensity = 1000
        }

        def DistantLight "Sun"
        {
            float inputs:angle = 1
            float inputs:intensity = 1500
            matrix4d xformOp:transform = ( (0.9396926207859084, -0.3420201433256687, -2.7755575615628914e-17, 0), (0.19617469496901105, 0.5389855446957562, 0.8191520442889919, 0), (-0.2801664995932355, -0.7697511313200573, 0.573576436351046, 0), (-0.2801664995932355, -0.7697511313200572, 0.5735764363510462, 1) )
            uniform token[] xformOpOrder = ["xformOp:transform"]
        }
    }

    def Scope "Looks"
    {
        def Material "asphalt"
        {
            token outputs:surface.connect = </World/Looks/asphalt/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.18, 0.18, 0.19)
                float inputs:metallic = 0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "line_white"
        {
            token outputs:surface.connect = </World/Looks/line_white/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.92, 0.92, 0.9)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "island"
        {
            token outputs:surface.connect = </World/Looks/island/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.5, 0.5, 0.48)
                float inputs:metallic = 0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "wall_white"
        {
            token outputs:surface.connect = </World/Looks/wall_white/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.85, 0.82)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
