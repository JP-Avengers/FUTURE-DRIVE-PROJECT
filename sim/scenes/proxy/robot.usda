#usda 1.0
(
    customLayerData = {
        string generated_by = "sim/build_proxy_scene.py"
        string params = "sim/scenes/proxy/params.yaml"
        string proxy_version = "v0"
    }
    doc = "sim/build_proxy_scene.py 가 만든 레이어 — 손으로 고치지 말고 params.yaml 을 고쳐 다시 만들 것"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "Nova_Carter_ROS" (
        prepend references = @https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Isaac/6.0/Isaac/Samples/ROS2/Robots/Nova_Carter_ROS.usd@
    )
    {
        float xformOp:rotateZ = 97.3
        double3 xformOp:translate = (-0.3, 2, 0)
        token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

        def Camera "ChaseCam"
        {
            float2 clippingRange = (0.1, 500)
            float focalLength = 18
            matrix4d xformOp:transform = ( (0, -1, 0, 0), (0.1579905011066728, 0, 0.9874406319167051, 0), (-0.9874406319167051, 0, 0.1579905011066728, 0), (-3.4999999999999996, -0, 1.7999999999999998, 1) )
            token[] xformOpOrder = ["xformOp:transform"]
        }
    }
}

