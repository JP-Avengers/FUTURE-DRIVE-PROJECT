#usda 1.0
(
    customLayerData = {
        string generated_by = "sim/build_proxy_scene.py"
        string params = "sim/scenes/proxy/params.yaml"
        string proxy_version = "v0"
    }
    defaultPrim = "World"
    doc = "Proxy 주차장 루트 — 이 파일을 연다. sim/build_proxy_scene.py 가 만든 레이어 — 손으로 고치지 말고 params.yaml 을 고쳐 다시 만들 것"
    metersPerUnit = 1
    subLayers = [
        @./sensors.usda@,
        @./ros.usda@,
        @./robot.usda@,
        @./env_proxy.usda@,
        @./background.usda@,
        @./world.usda@
    ]
    timeCodesPerSecond = 60
    upAxis = "Z"
)

