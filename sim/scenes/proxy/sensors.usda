#usda 1.0
(
    doc = "센서 덮어쓰기 — E2E 카메라 640×480 · Hawk 렌더 끄기. sim/author_proxy_layers.py 로 처음 만듦, 이후 GUI 로 고쳐도 됨"
)

over "World"
{
    over "Nova_Carter_ROS"
    {
        over "chassis_link"
        {
            over "sensors"
            {
                over "front_hawk"
                {
                    over "left"
                    {
                        def Camera "e2e_camera"
                        {
                            float2 clippingRange = (0.05, 500)
                            float focalLength = 18
                            float horizontalAperture = 36
                            float verticalAperture = 27
                            matrix4d xformOp:transform = ( (-4.440892098500626e-16, -1.0000000000000002, -2.220446049250313e-16, 0), (-2.220446049250313e-16, -4.440892098500626e-16, 1.0000000000000002, 0), (-1.0000000000000002, 2.220446049250313e-16, -4.440892098500626e-16, 0), (0, 0, 0, 1) )
                            uniform token[] xformOpOrder = ["xformOp:transform"]
                        }
                    }
                }
            }
        }

        over "front_hawk"
        {
            over "left_camera_render_product"
            {
                custom bool inputs:enabled = 0
            }

            over "right_camera_render_product"
            {
                custom bool inputs:enabled = 0
            }
        }
    }

    def OmniGraph "ROS_E2ECamera"
    {
        token evaluationMode = "Automatic"
        token evaluator:type = "execution"
        token fabricCacheBacking = "StageWithoutHistory"
        int2 fileFormatVersion = (1, 9)
        token pipelineStage = "pipelineStageSimulation"

        def OmniGraphNode "tick"
        {
            token node:type = "omni.graph.action.OnPlaybackTick"
            int node:typeVersion = 2
            custom double outputs:deltaSeconds
            custom double outputs:frame
            custom uint outputs:tick (
                customData = {
                    bool isExecution = 1
                }
            )
            custom double outputs:time
        }

        def OmniGraphNode "context"
        {
            custom uchar inputs:domain_id
            custom bool inputs:useDomainIDEnvVar
            token node:type = "isaacsim.ros2.bridge.ROS2Context"
            int node:typeVersion = 2
            custom uint64 outputs:context
        }

        def OmniGraphNode "render_product"
        {
            custom rel inputs:cameraPrim = </World/Nova_Carter_ROS/chassis_link/sensors/front_hawk/left/e2e_camera> (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            string relType = "target"
                        }
                    }
                }
            )
            custom bool inputs:enabled
            custom uint inputs:execIn (
                customData = {
                    bool isExecution = 1
                }
            )
            prepend uint inputs:execIn.connect = </World/ROS_E2ECamera/tick.outputs:tick>
            custom uint inputs:height = 480
            custom rel inputs:renderProductPrim (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            string relType = "target"
                        }
                    }
                }
            )
            custom uint inputs:width = 640
            token node:type = "isaacsim.core.nodes.IsaacCreateRenderProduct"
            int node:typeVersion = 3
            custom uint outputs:execOut (
                customData = {
                    bool isExecution = 1
                }
            )
            custom token outputs:renderProductPath
        }

        def OmniGraphNode "publish_image"
        {
            custom uint64 inputs:context
            prepend uint64 inputs:context.connect = </World/ROS_E2ECamera/context.outputs:context>
            custom bool inputs:enabled
            custom bool inputs:enableSemanticLabels
            custom uint inputs:execIn (
                customData = {
                    bool isExecution = 1
                }
            )
            prepend uint inputs:execIn.connect = </World/ROS_E2ECamera/render_product.outputs:execOut>
            custom string inputs:frameId = "front_camera_optical"
            custom uint inputs:frameSkipCount = 2
            custom string inputs:nodeNamespace
            custom string inputs:qosProfile
            custom uint64 inputs:queueSize
            custom token inputs:renderProductPath
            prepend token inputs:renderProductPath.connect = </World/ROS_E2ECamera/render_product.outputs:renderProductPath>
            custom bool inputs:resetSimulationTimeOnStop
            custom string inputs:semanticLabelsTopicName
            custom string inputs:srtxCompressionType
            custom float2 inputs:stereoOffset
            custom string inputs:topicName = "front_camera/image_raw"
            custom token inputs:type = "rgb" (
                allowedTokens = ["rgb", "rgb_h264", "depth", "depth_pcl", "instance_segmentation", "semantic_segmentation", "bbox_2d_tight", "bbox_2d_loose", "bbox_3d"]
            )
            custom bool inputs:useSystemTime
            token node:type = "isaacsim.ros2.bridge.ROS2CameraHelper"
            int node:typeVersion = 3
        }

        def OmniGraphNode "publish_info"
        {
            custom uint64 inputs:context
            prepend uint64 inputs:context.connect = </World/ROS_E2ECamera/context.outputs:context>
            custom bool inputs:enabled
            custom uint inputs:execIn (
                customData = {
                    bool isExecution = 1
                }
            )
            prepend uint inputs:execIn.connect = </World/ROS_E2ECamera/render_product.outputs:execOut>
            custom string inputs:frameId = "front_camera_optical"
            custom string inputs:frameIdRight
            custom uint inputs:frameSkipCount = 2
            custom string inputs:nodeNamespace
            custom string inputs:qosProfile
            custom uint64 inputs:queueSize
            custom token inputs:renderProductPath
            prepend token inputs:renderProductPath.connect = </World/ROS_E2ECamera/render_product.outputs:renderProductPath>
            custom token inputs:renderProductPathRight
            custom bool inputs:resetSimulationTimeOnStop
            custom string inputs:topicName = "front_camera/camera_info"
            custom string inputs:topicNameRight
            custom bool inputs:useSystemTime
            token node:type = "isaacsim.ros2.bridge.ROS2CameraInfoHelper"
            int node:typeVersion = 1
        }
    }
}

